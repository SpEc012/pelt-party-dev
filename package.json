{
  "name": "pelt-party",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:worker": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:socket": "node scripts/socket-test.mjs",
    "check": "npm test && npm run build",
    "test:integration": "node scripts/integration-runner.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "wrangler": "^4.0.0",
    "@playwright/test": "^1.55.0"
  }
}
