{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pelt-party",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/ws/*"] },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "PeltRoom" },
    { "name": "DIRECTORY", "class_name": "Directory" },
    { "name": "ACCOUNTS", "class_name": "Account" },
    { "name": "LEADERBOARD", "class_name": "Leaderboard" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PeltRoom", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Account", "Leaderboard"] }
  ]
}
